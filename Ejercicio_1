from pokemon_data import pokemon_data
from tree import BinaryTree
 
arbol_nombre = BinaryTree()
arbol_tipo = BinaryTree()
arbol_numero = BinaryTree()

for pokemon in pokemon_data:
    arbol_numero.insert_node(pokemon['numero'],pokemon)
    arbol_nombre.insert_node(pokemon['nombre'],pokemon)
    
    for tipo in pokemon['tipos']:
        node= arbol_tipo.search(tipo)
        if node is None:
            arbol_tipo.insert_node(tipo, [pokemon['nombre']])
        else:
            node.other_values.append(pokemon['nombre'])

print(f'pokemons cargados: {arbol_numero.count_nodes()}')

print('\nBusqueda por numero:')
nro = int(input('Ingrese un numero de pokemon:'))
node = arbol_numero.search(nro)
if node is None:
    print('no existe ese numero')
else:
    print(node.other_values)


print('\nbusqueda por nombre')
texto = input('ingrese parte del nombre: ')
encontrados = arbol_nombre.proxy_search(texto.lower())   # lower(): proxy_search compara en minúsculas
if len(encontrados) == 0:
    print('No hay Pokémons con ese texto')
else:
    for nodo in encontrados:
        print(nodo.other_values)
 
 
 
