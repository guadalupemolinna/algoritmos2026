from list_ import List

class Pokemon:
    def __init__(self, nombre, nivel, tipo, subtipo):
        self.nombre = nombre
        self.nivel = nivel      #define la estructura basica de cada pokémon
        self.tipo = tipo
        self.subtipo = subtipo

    def __str__(self):
        return f"-{self.nombre} (nivel: {self.nivel}, tipo: {self.tipo}/{self.subtipo})" # Define cómo se va a mostrar en texto un pokémon cuando se haga un print


class Entrenador:
    def __init__(self, nombre, torneos_ganados, batallas_perdidas, batallas_ganadas):  #define la estructura del entrenador
        self.nombre = nombre                                                        
        self.torneos_ganados = torneos_ganados  
        self.batallas_perdidas = batallas_perdidas
        self.batallas_ganadas = batallas_ganadas
        self.pokemons = List()  #cada entrenador tiene su propia instancia de la clase List para guardar sus pokemones

    def __str__(self):
        info = f"Entrenador: {self.nombre} | Torneos: {self.torneos_ganados} | Ganadas: {self.batallas_ganadas} | Perdidas: {self.batallas_perdidas}\n   Pokémons:" # Cadena inicial con datos grales del entrenador
        for poke in self.pokemons: # se recorre la sublista de pokémon de este entrenador en específico
            info += f"\n{poke}" #garra lo que ya estaba guardado, baja un renglón (\n), e imprime los datos formateados de ese pokemon repitiéndolo con cada pokémon que tenga el entrenador en su sublista
        return info #se devuelve todo el texto armado


def by_nombre_entrenador(item): #funciones auxiliares que reciben un objeto (item, que será un entrenador)
    return item.nombre            #y devuelven el atributo específico que se les pide (.nombre o .torneos_ganados)

def by_torneos_ganados(item):   #le enseñan a la lista qué valor exacto extraer y comparar cada vez
