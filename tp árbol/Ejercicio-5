from tree import BinaryTree
mcu = BinaryTree()

def generar_bosque(root, heroes, villains):
    if root is not None:
        if root.other_values['is_hero']:
            destino = heroes 
        else:
            destino = villains
        destino.insert_node(root.value, root.other_values)    
        generar_bosque(root.left, heroes, villains)
        generar_bosque(root.right, heroes, villains)

heroes = BinaryTree()
villains = BinaryTree()
