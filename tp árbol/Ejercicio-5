print("\nCorrección de Doctor Strange:")
encontrados = mcu.proxy_search('stra') #llama a la busqueda por proximidad con el fragmento "stra" devuelve la lista d nodos
                                       #cuyo nombre contiene stra y se guarda en encontrados
if encontrados: #pregunta si la lista tiene algo
    nodo = encontrados[0] #toma el primer nodo d la lista
    viejo = nodo.value #guarda el nombre mal escrito
    datos = nodo.other_values #guarda el diccionario del nodo al borrar el nodo se pierde ese dato,
                             #y hay que conservarlo para que el personaje siga siendo héro
    print('Encontrado:', viejo) #muestra el nombre viejo

    mcu.delete_node(viejo) #borra del arbol el nodo con nombre viejo
    mcu.insert_node('Doctor Strange', datos) #inseta un nodo nuevo con el nombre corregido y los mismos datos guardados 
    print('Corregido a: Doctor Strange')
